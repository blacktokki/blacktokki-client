{
  "name": "@blacktokki/notebook",
  "version": "1.0.0",
  "main": "index.js",
  "homepage": "http://blacktokki.github.io/blacktokki-notebook",
  "scripts": {
    "build": "yarn --cwd ../../ workspace @blacktokki/editor tinymce ../../apps/notebook/public",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 19006",
    "customize": "expo customize",
    "test:knowledgeGraph": "node --test src/features/knowledgeGraph/__tests__/ src/features/knowledgeGraph/inductiveTemplate/__tests__/",
    "test:inductiveTemplate": "node --test src/features/inductiveTemplate/__tests__/",
    "github": "expo export -p web && replace-in-file --configFile=scripts/seo.js && gh-pages -d dist --nojekyll -r https://github.com/blacktokki/blacktokki-notebook",
    "script:md": "node scripts/script-to-md.js"
  },
  "dependencies": {
    "@blacktokki/core": "*",
    "@blacktokki/editor": "*",
    "@blacktokki/eslint-config": "*",
    "@blacktokki/navigation": "*",
    "@expo/metro-runtime": "~56.0.21",
    "@orama/orama": "^3.1.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@huggingface/transformers": "4.3.2",
    "axios": "^1.18.0",
    "diff-match-patch": "^1.0.5",
    "expo": "^56.0.24",
    "expo-build-properties": "~56.0.27",
    "expo-splash-screen": "~56.0.16",
    "expo-constants": "~56.0.27",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.19",
    "expo-print": "~56.0.4",
    "expo-sharing": "~56.0.27",
    "expo-status-bar": "~56.0.4",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-native-paper": "^5.15.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-vector-icons": "*",
    "react-native-web": "*",
    "react-native-webview": "13.16.1",
    "react-query": "^3.39.3",
    "sanitize-html": "2.17.5"
  },
  "devDependencies": {
    "@babel/core": "*",
    "@types/diff-match-patch": "^1.0.36",
    "@types/react": "*",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/sanitize-html": "2.16.1",
    "gh-pages": "^6.1.0",
    "replace-in-file": "^7.0.1",
    "typescript": "~6.0.3"
  },
  "eslintConfig": {
    "extends": "@blacktokki/eslint-config"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "./node_modules"
      ]
    }
  },
  "private": true
}
